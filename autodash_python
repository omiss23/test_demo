#!/usr/bin/env python3
r"""AutoDash, the whole project in one Python file (version 2026-11-19).

Save this file as build_autodash.py and run it with Python 3.9 or newer. This step needs nothing installed:

    python build_autodash.py
        makes autodash.zip (the whole project) in the current folder

    python build_autodash.py --unpack "F:\Data Explorer"
        also puts the project in F:\Data Explorer\autodash. Files that are already there and the same are
        left alone; changed ones are replaced; nothing else in the folder is touched

    python build_autodash.py --list
        lists the project's files, writing nothing

The project is stored at the end of this file as text (a compressed archive written in base64) with a
SHA-256 checksum. If the file was damaged or cut short while being copied, the checksum says so and nothing
is written: copy it again. The last line of this file reads "# END OF build_autodash.py".

The sample files (sample_data/) are made again from engine/samples.py, which needs pandas, numpy and
openpyxl: the packages AutoDash itself needs. Without them the samples are left out; the app still offers
them under "Or try a sample".
"""
import argparse
import base64
import hashlib
import io
import os
import sys
import tarfile
import tempfile
import zipfile

VERSION = "2026-11-19"
FILE_COUNT = 84
ARCHIVE_SHA256 = "9b43e51c14200c213de7b7245f4117c1b01eab9f1c6c94fe7c1380382197ee70"
SAMPLES = {"retail": "retail_sales_messy.csv", "hr": "hr_attrition.xlsx", "web": "web_traffic.json",
           "payments": "payments_pacs008.xml", "feedback": "customer_feedback.csv",
           "transfers": "transfers_demo.csv"}


def fail(message):
    print("\n" + message, file=sys.stderr)
    sys.exit(1)


def read_archive():
    """The project's files: {path inside the project: bytes}, after checking nothing was changed."""
    text = "".join(PAYLOAD.split())              # whatever line breaks or indentation the copy picked up
    try:
        data = base64.b64decode(text, validate=True)
    except ValueError:
        fail("This file's data part has characters base64 doesn't use: it was changed while being copied. "
             "Copy build_autodash.py again.")
    if hashlib.sha256(data).hexdigest() != ARCHIVE_SHA256:
        fail("This file's data doesn't match its checksum: it was damaged or cut short while being copied "
             "(its last line should be '# END OF build_autodash.py'). Copy build_autodash.py again.")
    files = {}
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:xz") as tar:
        for m in tar.getmembers():
            name = m.name.replace("\\", "/")
            parts = name.split("/")
            if not m.isfile() or name.startswith("/") or ".." in parts or ":" in name:
                fail("Unexpected entry in the archive: %r. Nothing was written." % m.name)
            files[name] = tar.extractfile(m).read()
    if len(files) != FILE_COUNT:
        fail("The archive holds %d files instead of %d. Nothing was written." % (len(files), FILE_COUNT))
    return files


def make_samples(files):
    """sample_data/*: made by the project's own engine/samples.py, in a temporary copy of the project."""
    try:
        with tempfile.TemporaryDirectory() as tmp:
            for name in ("engine/__init__.py", "engine/samples.py"):
                path = os.path.join(tmp, *name.split("/"))
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "wb") as f:
                    f.write(files[name])
            sys.path.insert(0, tmp)
            try:
                from engine.samples import get_sample
                made = {}
                for key, name in SAMPLES.items():
                    got_name, data = get_sample(key)
                    made["sample_data/" + (got_name or name)] = data
            finally:
                sys.path.remove(tmp)
                for mod in [m for m in sys.modules if m == "engine" or m.startswith("engine.")]:
                    del sys.modules[mod]
        return made, ""
    except Exception as exc:  # pandas, numpy or openpyxl missing in this Python
        return {}, "%s: %s" % (type(exc).__name__, exc)


def write_zip(files, dest):
    tmp = dest + ".part"
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as z:
        for name in sorted(files):
            z.writestr("autodash/" + name, files[name])
    os.replace(tmp, dest)


def unpack(files, parent):
    target = os.path.join(parent, "autodash")
    new = changed = same = 0
    for name in sorted(files):
        path = os.path.join(target, *name.split("/"))
        data = files[name]
        if name.startswith("sample_data/") and os.path.isfile(path):
            same += 1                                # demo files: the ones already there are kept
            continue
        if os.path.isfile(path):
            with open(path, "rb") as f:
                if f.read() == data:
                    same += 1
                    continue
            changed += 1
        else:
            new += 1
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path + ".part", "wb") as f:
                f.write(data)
            os.replace(path + ".part", path)
        except OSError as exc:
            fail("Couldn't write %s (%s). If AutoDash is running from that folder, stop it and run this again."
                 % (path, exc.strerror or exc))
    return target, new, changed, same


def main():
    ap = argparse.ArgumentParser(description="Recreates the AutoDash project (version %s)." % VERSION)
    ap.add_argument("--unpack", nargs="?", const=".", metavar="FOLDER",
                    help="also put the project in FOLDER/autodash (default: the current folder)")
    ap.add_argument("--zip", default="autodash.zip", metavar="FILE", help="where to write the zip (autodash.zip)")
    ap.add_argument("--list", action="store_true", help="list the files and write nothing")
    args = ap.parse_args()

    files = read_archive()
    print("AutoDash %s: %d files, checksum OK." % (VERSION, len(files)))
    if args.list:
        try:
            for name in sorted(files):
                print("  %9d  %s" % (len(files[name]), name))
        except BrokenPipeError:                     # the list was cut short (piped to `more`, say)
            pass
        return
    samples, why = make_samples(files)
    if samples:
        files.update(samples)
        print("Made the %d sample files (sample_data/)." % len(samples))
    else:
        print("Left out the sample files: this Python can't make them (%s). The app still offers them." % why)
    zip_path = os.path.abspath(args.zip)
    try:
        write_zip(files, zip_path)
    except OSError as exc:
        fail("Couldn't write %s (%s)." % (zip_path, exc.strerror or exc))
    print("Wrote %s (%.2f MB)." % (zip_path, os.path.getsize(zip_path) / 1e6))
    if args.unpack is not None:
        target, new, changed, same = unpack(files, os.path.abspath(args.unpack))
        print("Project in %s: %d new, %d replaced, %d already the same." % (target, new, changed, same))
        print("Start it with:  cd \"%s\"  then  streamlit run app.py" % target)


