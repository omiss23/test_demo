def build_month(wb, year, m, grid=None):
    ws = wb.create_sheet(f'{MON[m - 1]}-{year}')
    ws.sheet_properties.tabColor = YEAR_TAB[YEARS.index(year) % 2]
    ws.sheet_view.showGridLines = False
    ws.sheet_view.zoomScale = 90
    w = {'A': 6.5, 'B': 10, 'C': 24, 'D': 14, 'E': 14, 'F': 16, 'G': 14}
    w.update({c: 6.2 for c in DAYC})
    w.update({c: 9.5 for c in SUMC})
    widths(ws, w)
    # --- header block
    ws.merge_cells('A1:G1')
    put(ws, 'A1', '=IFERROR(INDEX(MonthNames,$B$3)&" "&$B$2,"Check Year/Month")&"  \xb7  Attendance"',
        F(14, True, color=GREEN), align=A_L)
    ws.row_dimensions[1].height = 24
    put(ws, 'A2', 'Year', F(9, True, color=MUTED), align=A_R)
    put(ws, 'B2', year, F(10, True), FILL(INPUT), B_BOX, A_C, '0', unlocked=True)
    put(ws, 'C2', '=HYPERLINK("#Dashboard!A1","\u2302 Back to Dashboard")',
        F(9, color='2F5597', underline='single'), align=A_L)
    put(ws, 'A3', 'Month', F(9, True, color=MUTED), align=A_R)
    put(ws, 'B3', m, F(10, True), FILL(INPUT), B_BOX, A_C, '0', unlocked=True)
    put(ws, 'C3', 'tab settings \u2014 change only when copying tabs for a new year',
        F(8, italic=True, color=MUTED), align=A_L)
    put(ws, 'G2', 'Codes \u2192', F(8, True, color=MUTED), align=A_R)
    for k in range(12):
        put(ws, f'{DAYC[k]}2', f'=IF(code_{k + 1}="","",code_{k + 1})', F(8, True), FILL(SLOT[k]), B_GRID, A_C)
    ws.merge_cells(f'{DA}3:{DZ}3')
    put(ws, f'{DA}3', 'Pick a code from the dropdown in each day cell (the blank item at the end clears it)  \xb7  '
                      'invalid entries turn red  \xb7  dark header = weekend  \xb7  amber = holiday  \xb7  grey = not a '
                      'date in this month',
        F(8, italic=True, color=MUTED), align=A_L)
    # --- daily headcount rows 4-7
    for i, (lab, rng) in enumerate([('Present', 'CatRange'), ('Leave/ISPL Holiday', 'CatRange'),
                                    ('Early Morning', 'ShiftRange'), ('Late Evening', 'ShiftRange')]):
        r = 4 + i
        ws.merge_cells(f'C{r}:G{r}')
        for c in 'CDEFG':
            put(ws, f'{c}{r}', None, F(8, True, color='595959'), FILL(GREY_L), B_GRID, A_R, '@"  \xb7  per day"')
        ws[f'C{r}'].value = lab
        for c in DAYC:
            put(ws, f'{c}{r}', f'=IF({c}$9="","",SUMPRODUCT(COUNTIFS(CodeRange,{c}${G0}:{c}${G1},{rng},$C{r})'
                               f'*({c}${G0}:{c}${G1}<>"")*($B${G0}:$B${G1}<>"")))',
                F(8, color='404040'), None, B_GRID, A_C, '0;-0;;@')
    # --- month totals (rows 7-8, right) and day headers (rows 8-9)
    ws.merge_cells(f'{SA}7:{SZ}7')
    for c in SUMC:
        put(ws, f'{c}7', None, F(8, True, color='595959'), FILL(GREY_L), B_GRID, A_C)
        put(ws, f'{c}8', f'=SUBTOTAL(9,{c}{G0}:{c}{G1})', F(9, True), FILL(GREY_L), B_GRID, A_C, FMT_CNT)
    ws[f'{SA}7'].value = 'Month total (visible rows)'
    for i, c in enumerate(DAYC):
        put(ws, f'{c}8', f'=IF({c}9="","",{c}9)', F(8, color='374151'), FILL(GREEN_L), B_GRID, A_C, 'ddd')
        p = DAYC[i - 1]
        f9 = '=DATE($B$2,$B$3,1)' if i == 0 else f'=IF({p}9="","",IF(MONTH({p}9+1)=$B$3,{p}9+1,""))'
        put(ws, f'{c}9', f9, F(9, True), FILL(GREEN_L), B_GRID, A_C, 'd')
    for c, h in zip('ABCDEFG', ['#', 'ID', 'Employee Name', 'Team', 'Sub Team', 'Manager', 'Vendor']):
        header(ws, f'{c}9', h, 9)
    for c, h in zip(SUMC, SUM_LABELS):
        header(ws, f'{c}9', h, 9)
    ws.row_dimensions[9].height = 30
    # --- employee rows: style row G0 once, copy the style arrays to the other rows (fast)
    protos = {}

    def proto(ci, **kw):
        cell = ws.cell(row=G0, column=ci)
        put(ws, cell.coordinate, **kw)
        protos[ci] = cell._style

    proto(1, font=F(8, color=MUTED), border=B_GRID, align=A_C)
    proto(2, font=F(9), border=B_GRID, align=A_C)
    for ci in (3, 4, 5, 6, 7):
        proto(ci, font=F(9), border=B_GRID, align=A_L)
    for ci in range(DAY0, DAY0 + 31):
        proto(ci, font=F(9), border=B_GRID, align=A_C, unlocked=True)
    for ci in range(SUM0, SUM0 + 6):
        proto(ci, font=F(9), fill=FILL('F7F7F7'), border=B_GRID, align=A_C, fmt=FMT_CNT)
    for i in range(N_EMP):
        r = G0 + i
        vals = {1: i + 1,
                2: f'=IF(INDEX(MasterID,$A{r})="","",INDEX(MasterID,$A{r}))',
                3: f'=INDEX(MasterName,$A{r})&""', 4: f'=INDEX(MasterTeam,$A{r})&""',
                5: f'=INDEX(MasterSub,$A{r})&""', 6: f'=INDEX(MasterMgr,$A{r})&""',
                7: f'=INDEX(MasterVendor,$A{r})&""'}
        codes = grid.get(i) if grid else None
        if codes:
            for d, code in enumerate(codes[:31]):
                if code:
                    vals[DAY0 + d] = code
        for k, (sc, rng) in enumerate(zip(SUMC, SUM_RANGE)):
            vals[SUM0 + k] = (f'=IF($B{r}="","",SUMPRODUCT(COUNTIFS(CodeRange,${DA}{r}:${DZ}{r},{rng},{sc}$9)'
                              f'*(${DA}$9:${DZ}$9<>"")*(${DA}{r}:${DZ}{r}<>"")))')
        for ci in range(1, SUM0 + 6):
            cell = ws.cell(row=r, column=ci)
            if ci in vals:
                cell.value = vals[ci]
            if i:
                cell._style = copy(protos[ci])
    # --- conditional formats (added in priority order)
    body = f'{DA}{G0}:{DZ}{G1}'
    cf(ws, f'{DA}4:{DZ}{G1}', f'{DA}$9=""', fill='A6A6A6', stop=True)
    cf(ws, body, f'AND({DA}{G0}<>"",COUNTIF(CodeRange,{DA}{G0})=0)', fill='E74C3C', font=CFF(True, color='FFFFFF'))
    for k in range(12):
        cf(ws, body, f'AND({DA}{G0}<>"",{DA}{G0}=code_{k + 1})', fill=SLOT[k])
    cf(ws, f'{DA}8:{DZ}9', f'AND({DA}$9<>"",COUNTIF(HolidayDates,{DA}$9)>0)', fill='F4B183',
       font=CFF(True, color='1F2937'))
    cf(ws, f'{DA}8:{DZ}9', f'AND({DA}$9<>"",WEEKDAY({DA}$9,2)>5)', fill='4B5563', font=CFF(True, color='FFFFFF'))
    cf(ws, body, f'AND({DA}$9<>"",COUNTIF(HolidayDates,{DA}$9)>0)', fill='FDF1E4')
    cf(ws, body, f'AND({DA}$9<>"",WEEKDAY({DA}$9,2)>5)', fill='F3F3F3')
    cf(ws, f'{DAYC[0]}2:{DAYC[11]}2', f'{DA}2=""', fill='FFFFFF')
    # --- validation, view, print, protection
    dv_num(ws, 'B2', 'whole', 2000, 2100, 'Year', 'Enter a 4-digit year, e.g. 2027.')
    dv_num(ws, 'B3', 'whole', 1, 12, 'Month', 'Enter the month number, 1 to 12.')
    dv_list(ws, body, 'CodeList', 'Not a valid code',
            'Pick a code from the dropdown. To add a new code, fill a spare row on the Codes tab.')
    ws.freeze_panes = f'D{G0}'
    ws.auto_filter.ref = f'A9:{SZ}{G1}'
    page(ws, landscape=True, titles='8:9')
    protect(ws, allow_filter=True)


def build_helper(wb):
    ws = wb.create_sheet('Helper')
    ws.sheet_state = 'hidden'
    put(ws, 'A1', 'Helper \u2014 calculated lists behind the dropdowns and filters. Do not edit.', F(9, True))
    for ref, v in {'B4': 'team idx', 'C4': 'Teams', 'D4': 'sub idx', 'E4': 'Sub Teams',
                   'F4': 'dash sub idx', 'G4': 'Sub Teams (dashboard)', 'I4': 'Months', 'J4': 'Month names',
                   'K4': 'Status', 'L4': 'Counts as', 'M4': 'Shift', 'N4': 'Filter', 'O4': 'Criteria',
                   'Q4': 'code idx', 'R4': 'Codes', 'T4': 'vendor idx', 'U4': 'Vendors',
                   'V4': 'position', 'W4': 'member idx'}.items():
        put(ws, ref, v, F(9, True))
    for ref in ('B5', 'D5', 'F5', 'Q5', 'T5', 'W5'):
        ws[ref] = 0
    for ref in ('C5', 'G5', 'I5', 'U5'):
        ws[ref] = 'All'
    for r in range(6, 106):
        ws[f'B{r}'] = f'=IF(Setup!B{r}="","",IF(COUNTIF(Setup!$B$6:B{r},Setup!B{r})=1,MAX(B$5:B{r - 1})+1,""))'
        ws[f'C{r}'] = f'=IFERROR(INDEX(Setup!$B$6:$B$105,MATCH(ROWS(C$6:C{r}),$B$6:$B$105,0)),"")'
        ws[f'D{r}'] = f'=IF(Setup!C{r}="","",IF(COUNTIF(Setup!$C$6:C{r},Setup!C{r})=1,MAX(D$5:D{r - 1})+1,""))'
        ws[f'E{r}'] = f'=IFERROR(INDEX(Setup!$C$6:$C$105,MATCH(ROWS(E$6:E{r}),$D$6:$D$105,0)),"")'
        ws[f'F{r}'] = (f'=IF(Setup!C{r}="","",IF(IF(TeamSel="All",COUNTIF(Setup!$C$6:C{r},Setup!C{r})=1,'
                       f'AND(Setup!B{r}=TeamSel,COUNTIFS(Setup!$B$6:B{r},Setup!B{r},Setup!$C$6:C{r},'
                       f'Setup!C{r})=1)),MAX(F$5:F{r - 1})+1,""))')
        ws[f'G{r}'] = f'=IFERROR(INDEX(Setup!$C$6:$C$105,MATCH(ROWS(G$6:G{r}),$F$6:$F$105,0)),"")'
    for i in range(12):
        ws[f'I{6 + i}'] = MON[i]
        ws[f'J{6 + i}'] = MON_FULL[i]
    ws['K6'], ws['K7'] = 'Active', 'Inactive'
    for i, c in enumerate(CATEGORIES):
        ws[f'L{6 + i}'] = c
    for i, s in enumerate(SHIFTS):
        ws[f'M{6 + i}'] = s
    ws['N6'], ws['O6'] = 'TeamCrit', '=IF(TeamSel="All","<>\xa7\xa7","="&TeamSel)'
    ws['N7'], ws['O7'] = 'SubCrit', '=IF(SubSel="All","<>\xa7\xa7","="&SubSel)'
    ws['N8'], ws['O8'] = 'VendorCrit', '=IF(VendorSel="All","<>\xa7\xa7","="&VendorSel)'
    ws['N9'], ws['O9'] = 'SelTab', '="\'"&MonthSel&"-"&YearSel&"\'!"'
    for r in range(6, 18):
        ws[f'Q{r}'] = f'=IF(Codes!B{r - 2}="","",MAX(Q$5:Q{r - 1})+1)'
        ws[f'R{r}'] = f'=IFERROR(INDEX(Codes!$B$4:$B$15,MATCH(ROWS(R$6:R{r}),$Q$6:$Q$17,0)),"")'
    ws['R18'] = '=""'                             # blank dropdown item when all 12 code slots are used
    for r in range(6, 56):                        # unique vendors from Setup J6:J55
        ws[f'T{r}'] = f'=IF(Setup!J{r}="","",IF(COUNTIF(Setup!$J$6:J{r},Setup!J{r})=1,MAX(T$5:T{r - 1})+1,""))'
        ws[f'U{r}'] = f'=IFERROR(INDEX(Setup!$J$6:$J$55,MATCH(ROWS(U$6:U{r}),$T$6:$T$55,0)),"")'
    for i in range(N_EMP):                        # employees matching the Dashboard filters, numbered 1, 2, 3 ...
        r = 6 + i
        ws[f'V{r}'] = i + 1
        ws[f'W{r}'] = (f'=IF(AND(INDEX(MasterID,$V{r})<>"",OR(TeamSel="All",INDEX(MasterTeam,$V{r})=TeamSel),'
                       f'OR(SubSel="All",INDEX(MasterSub,$V{r})=SubSel),'
                       f'OR(VendorSel="All",INDEX(MasterVendor,$V{r})=VendorSel)),MAX(W$5:W{r - 1})+1,"")')
    protect(ws)


def add_names(wb):
    add_name(wb, 'CodeRange', 'Codes!$B$4:$B$15')
    add_name(wb, 'CatRange', 'Codes!$D$4:$D$15')
    add_name(wb, 'ShiftRange', 'Codes!$E$4:$E$15')
    for k in range(12):
        add_name(wb, f'code_{k + 1}', f'Codes!$B${4 + k}')
    # codes in use + one blank item at the end (picking it clears the day cell)
    add_name(wb, 'CodeList', 'OFFSET(Helper!$R$6,0,0,SUMPRODUCT(--(LEN(Helper!$R$6:$R$17)>0))+1,1)')
    add_name(wb, 'TeamList', 'OFFSET(Helper!$C$6,0,0,MAX(1,SUMPRODUCT(--(LEN(Helper!$C$6:$C$105)>0))),1)')
    add_name(wb, 'TeamListDash', 'OFFSET(Helper!$C$5,0,0,SUMPRODUCT(--(LEN(Helper!$C$5:$C$105)>0)),1)')
    add_name(wb, 'SubTeamList', 'OFFSET(Helper!$E$6,0,0,MAX(1,SUMPRODUCT(--(LEN(Helper!$E$6:$E$105)>0))),1)')
    add_name(wb, 'SubTeamListDash', 'OFFSET(Helper!$G$5,0,0,SUMPRODUCT(--(LEN(Helper!$G$5:$G$105)>0)),1)')
    add_name(wb, 'VendorList', 'OFFSET(Helper!$U$6,0,0,MAX(1,SUMPRODUCT(--(LEN(Helper!$U$6:$U$55)>0))),1)')
    add_name(wb, 'VendorListDash', 'OFFSET(Helper!$U$5,0,0,SUMPRODUCT(--(LEN(Helper!$U$5:$U$55)>0)),1)')
    add_name(wb, 'YearList', 'OFFSET(Setup!$H$6,0,0,MAX(1,COUNT(Setup!$H$6:$H$40)),1)')
    add_name(wb, 'MonthListAll', 'Helper!$I$5:$I$17')
    add_name(wb, 'MonthNames', 'Helper!$J$6:$J$17')
    add_name(wb, 'StatusList', 'Helper!$K$6:$K$7')
    add_name(wb, 'CategoryList', 'Helper!$L$6:$L$10')
    add_name(wb, 'ShiftList', 'Helper!$M$6:$M$7')
    add_name(wb, 'HolidayDates', 'Setup!$E$6:$E$55')
    add_name(wb, 'SetupTeam', 'Setup!$B$6:$B$105')
    add_name(wb, 'SetupSub', 'Setup!$C$6:$C$105')
    add_name(wb, 'SetupVendor', 'Setup!$J$6:$J$55')
    for nm, col in [('MasterID', 'B'), ('MasterName', 'C'), ('MasterTeam', 'D'), ('MasterSub', 'E'),
                    ('MasterMgr', 'F'), ('MasterVendor', 'G'), ('MasterStatus', 'H')]:
        add_name(wb, nm, f"'Employee Master'!${col}${M0}:${col}${M1}")
    for nm, ref in [('YearSel', 'B5'), ('MonthSel', 'D5'), ('TeamSel', 'F5'), ('SubSel', 'H5'),
                    ('VendorSel', 'J5')]:
        add_name(wb, nm, f'Dashboard!${ref[0]}${ref[1:]}')
    add_name(wb, 'TeamCrit', 'Helper!$O$6')
    add_name(wb, 'SubCrit', 'Helper!$O$7')
    add_name(wb, 'VendorCrit', 'Helper!$O$8')
    add_name(wb, 'SelTab', 'Helper!$O$9')


def build(path):
    wb = Workbook()
    arial = Font(name='Arial', size=10, family=2)
    try:                                         # Arial 10 as the workbook's default font
        wb._fonts = IndexedList([arial])
        wb._named_styles['Normal'].font = arial
    except Exception:
        pass
    wb.remove(wb.active)
    build_dashboard(wb, (YEARS[0], 'All', 'All', 'All', 'All'))
    build_guide(wb)
    build_master(wb)
    build_setup(wb)
    build_codes(wb)
    for y in YEARS:
        for m in range(1, 13):
            build_month(wb, y, m)
    build_helper(wb)
    add_names(wb)
    hidden = Protection(locked=True, hidden=True)     # formulas don't show in the formula bar
    for ws in wb.worksheets:
        for c in ws._cells.values():
            if c.data_type == 'f':
                c.protection = hidden
    wb.calculation = CalcProperties(fullCalcOnLoad=True)
    wb.active = 0
    wb.properties.title = 'Attendance Tracker'
    wb.properties.creator = 'Attendance Tracker'
    wb.save(path)


# ================================================================ run
def check_settings():
    problems = []
    if not YEARS or len(set(YEARS)) != len(YEARS) or len(YEARS) > 35:
        problems.append('YEARS must list each year once (at most 35 years), e.g. [2026, 2027]')
    if not 1 <= N_EMP <= 2000:
        problems.append('N_EMP must be between 1 and 2000')
    if len(SETUP_PAIRS) > 100:
        problems.append('SETUP_PAIRS: at most 100 pairs')
    if len(VENDORS) > 50:
        problems.append('VENDORS: at most 50 vendors')
    if EXAMPLE_EMPLOYEE and len(EXAMPLE_EMPLOYEE) != 7:
        problems.append('EXAMPLE_EMPLOYEE needs 7 values: ID, Name, Team, Sub Team, Manager, Vendor, Status')
    if len(YEARS) * len(HOLIDAY_DATES) > 50:
        problems.append('Holidays: at most 50 dates in total (number of YEARS x HOLIDAY_DATES)')
    if len(CODES) > 12:
        problems.append('CODES: at most 12 codes')
    for code in CODES:
        if code[2] not in CATEGORIES:
            problems.append('CODES %s: "counts as" must be one of: %s' % (code[0], ', '.join(CATEGORIES)))
        if code[3] and code[3] not in SHIFTS:
            problems.append('CODES %s: shift must be blank or one of: %s' % (code[0], ', '.join(SHIFTS)))
    if problems:
        sys.exit('Please fix the SETTINGS at the top of the script:\n  - ' + '\n  - '.join(problems))


def main():
    args = [a for a in sys.argv[1:] if a != '--force']
    out = args[0] if args else OUTPUT_FILE
    if not out.lower().endswith('.xlsx'):
        out += '.xlsx'
    if os.path.exists(out) and '--force' not in sys.argv[1:]:
        sys.exit('%s already exists - not overwriting it. Give another file name, or add --force.' % out)
    check_settings()
    print('Building %s ...' % out)
    try:
        build(out)
    except PermissionError:
        sys.exit('Could not save %s - if it is open in Excel, close it and run again.' % out)
    print('Done: %s' % os.path.abspath(out))
    print('%d month tabs, %d employee rows. Open it in Excel (formulas calculate on open), then save once.'
          % (12 * len(YEARS), N_EMP))


if __name__ == '__main__':
    main()
