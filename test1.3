    ws.row_dimensions[1].height = 28
    r = 3
    for kind, text in GUIDE:
        if kind == 'h':
            if r > 3:
                r += 1
            ws.merge_cells(f'B{r}:C{r}')
            for c in 'BC':
                put(ws, f'{c}{r}', None, F(10, True, color='FFFFFF'), FILL(GREEN), None, A_L)
