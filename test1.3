# ================================================================ sheets
def build_dashboard(wb, sel):
    ws = wb.create_sheet('Dashboard')
    ws.sheet_properties.tabColor = TAB['dash']
    ws.sheet_view.showGridLines = False
    w = {'A': 2, 'B': 11, 'C': 22, 'N': 2}
    w.update({c: 12.5 for c in 'DEFGHIJLM'})
    w['K'] = 15
    widths(ws, w)
    for c in 'PQ':
        ws.column_dimensions[c].hidden = True
    put(ws, 'B1', 'Attendance Dashboard', F(18, True, color=GREEN), align=A_L)
    ws.row_dimensions[1].height = 30
    put(ws, 'B2', '="Year "&YearSel&"   \xb7   "&IF(MonthSel="All","All months",MonthSel)&"   \xb7   Team: "'
                  '&TeamSel&"   \xb7   Sub Team: "&SubSel&"   \xb7   Vendor: "&VendorSel', F(10, color=MUTED), align=A_L)
    y, mo, t, s, v = sel
    for c1, c2, lab, val, src, word in [('B', 'C', 'YEAR', y, 'YearList', 'year'),
                                        ('D', 'E', 'MONTH', mo, 'MonthListAll', 'month'),
                                        ('F', 'G', 'TEAM', t, 'TeamListDash', 'team'),
                                        ('H', 'I', 'SUB TEAM', s, 'SubTeamListDash', 'sub team'),
                                        ('J', 'K', 'VENDOR', v, 'VendorListDash', 'vendor')]:
        put(ws, f'{c1}4', lab, F(8, True, color=MUTED), align=A_L)
        ws.merge_cells(f'{c1}5:{c2}5')
        for c in (c1, c2):
            put(ws, f'{c}5', None, F(11, True), FILL(INPUT), B_BOX, A_C, '0', unlocked=True)
        ws[f'{c1}5'].value = val
        dv_list(ws, f'{c1}5', src, 'Pick from the list', f'Choose a {word} from the dropdown.')
    ws.row_dimensions[5].height = 24
    ws.merge_cells('B6:M6')
    put(ws, 'B6', WARN, F(8, italic=True, color=MUTED), align=A_L)
    ws.row_dimensions[6].height = 18

    def kpi(col):
        return (f'=IFERROR(IF(MonthSel="All",${col}$43,'
                f'INDEX(${col}$31:${col}$42,MATCH(MonthSel,$B$31:$B$42,0))),0)')

    def cap(unit):
        return f'=IF(MonthSel="All","{unit} \xb7 all of "&YearSel,"{unit} \xb7 "&MonthSel&" "&YearSel)'

    emp = ('=SUMPRODUCT((MasterID<>"")*(MasterStatus<>"Inactive")'
           '*(((TeamSel="All")+(MasterTeam=TeamSel))>0)*(((SubSel="All")+(MasterSub=SubSel))>0)'
           '*(((VendorSel="All")+(MasterVendor=VendorSel))>0))')
    cards = [('B', 'C', 'EMPLOYEES', emp, 'active, matching the filters', '1F2937', '#,##0'),
             ('D', 'E', 'PRESENT', kpi('C'), cap('person-days'), '2F5597', '#,##0'),
             ('F', 'G', 'LEAVE / ISPL HOLIDAY', kpi('D'), cap('person-days'), 'C55A11', '#,##0'),
             ('H', 'I', 'EARLY MORNING', kpi('E'), cap('shifts'), '1B7F6E', '#,##0'),
             ('J', 'K', 'LATE EVENING', kpi('F'), cap('shifts'), '6B4FA0', '#,##0'),
             ('L', 'M', 'ATTENDANCE %', '=IF(D8+F8=0,"\u2013",D8/(D8+F8))', 'present \xf7 (present + leave)',
              '1F7A3F', '0.0%')]
    for c1, c2, lab, formula, capt, color, fmt in cards:
        for r in (7, 8, 9):
            ws.merge_cells(f'{c1}{r}:{c2}{r}')
            for c in (c1, c2):
                cell = ws[f'{c}{r}']
                cell.fill = FILL('F4F7F5')
                cell.border = Border(left=S_BOX if c == c1 else Side(),
                                     right=S_BOX if c == c2 else Side(),
                                     top=Side(style='thick', color=color) if r == 7 else Side(),
                                     bottom=S_BOX if r == 9 else Side())
        put(ws, f'{c1}7', lab, F(8, True, color=MUTED), align=A_C)
        put(ws, f'{c1}8', formula, F(20, True, color=color), align=A_C, fmt=fmt)
        put(ws, f'{c1}9', capt, F(8, color=MUTED), align=A_C)
    ws.row_dimensions[7].height = 20
    ws.row_dimensions[8].height = 34
    ws.row_dimensions[9].height = 18

    # ---- month-wise table (rows 30-43) -- the charts and cards read from it
    put(ws, 'B29', '="Month-wise summary  \xb7  "&YearSel&"  \xb7  "&IF(TeamSel="All","All teams",TeamSel)'
                   '&IF(SubSel="All",""," / "&SubSel)&IF(VendorSel="All","","  \xb7  Vendor: "&VendorSel)',
        F(12, True, color=GREEN), align=A_L)
    ws.row_dimensions[29].height = 22
    for c, h in zip('BCDEFGHIJK', ['Month'] + SUM_LABELS + ['Attendance %', 'Tab', 'Check']):
        header(ws, f'{c}30', h, 9)
    ws.row_dimensions[30].height = 28
    for i in range(12):
        r = 31 + i
        band = FILL('FFFFFF' if i % 2 == 0 else 'F7F9F8')
        put(ws, f'B{r}', MON[i], F(10, True), band, B_GRID, A_C)
        ws[f'P{r}'] = f'="\'"&$B{r}&"-"&YearSel&"\'!"'
        ws[f'Q{r}'] = i + 1
        for c, src in zip('CDEFGH', SUMC):
            put(ws, f'{c}{r}',
                f'=IFERROR(SUMIFS(INDIRECT($P{r}&"${src}${G0}:${src}${G1}"),'
                f'INDIRECT($P{r}&"$D${G0}:$D${G1}"),TeamCrit,'
                f'INDIRECT($P{r}&"$E${G0}:$E${G1}"),SubCrit,'
                f'INDIRECT($P{r}&"$G${G0}:$G${G1}"),VendorCrit),0)',
                F(10), band, B_GRID, A_C, FMT_CNT)
        put(ws, f'I{r}', f'=IF(C{r}+D{r}=0,"\u2013",C{r}/(C{r}+D{r}))', F(10), band, B_GRID, A_C, '0.0%')
        put(ws, f'J{r}', f'=IF(ISREF(INDIRECT($P{r}&"A1")),HYPERLINK("#"&$P{r}&"A1",'
                         f'$B{r}&"-"&YearSel&" \u2192"),"No tab yet")', F(9, color='2F5597'), band, B_GRID, A_C)
        put(ws, f'K{r}', f'=IF(ISREF(INDIRECT($P{r}&"A1")),IF(AND(INDIRECT($P{r}&"B2")=YearSel,'
                         f'INDIRECT($P{r}&"B3")=$Q{r}),"\u2713","\u26a0 Check B2/B3"),"")',
            F(10, True, color='1F7A3F'), band, B_GRID, A_C)
    tb = Border(top=Side(style='medium', color=GREEN), bottom=S_BOX, left=S_GRID, right=S_GRID)
    put(ws, 'B43', 'Total', F(10, True), FILL(GREEN_L), tb, A_C)
    for c in 'CDEFGH':
        put(ws, f'{c}43', f'=SUM({c}31:{c}42)', F(10, True), FILL(GREEN_L), tb, A_C, FMT_CNT)
    put(ws, 'I43', '=IF(C43+D43=0,"\u2013",C43/(C43+D43))', F(10, True), FILL(GREEN_L), tb, A_C, '0.0%')
    put(ws, 'J43', None, F(9), FILL(GREEN_L), tb, A_C)
    put(ws, 'K43', '=COUNTIF(K31:K42,"\u2713")&" of 12 \u2713"', F(9, True, color=MUTED), FILL(GREEN_L), tb, A_C)
    for k, text in enumerate(DASH_NOTES):
        r = 45 + k
        ws.merge_cells(f'B{r}:M{r}')
        put(ws, f'B{r}', text, F(8, italic=True, color=MUTED), align=A_LW)
        ws.row_dimensions[r].height = 22

    # ---- team-member table: one row per employee matching the filters (Helper column W lists them)
    put(ws, f'B{MT_TITLE}', '="Team member summary  \xb7  "&IF(MonthSel="All","all of "&YearSel,MonthSel&" "&YearSel)'
                            '&"  \xb7  "&IF(TeamSel="All","All teams",TeamSel)&IF(SubSel="All",""," / "&SubSel)'
                            '&IF(VendorSel="All","","  \xb7  Vendor: "&VendorSel)', F(12, True, color=GREEN), align=A_L)
    ws.row_dimensions[MT_TITLE].height = 22
    for c, h in zip('BCDEFGHIJKLM', ['ID', 'Employee Name', 'Team', 'Sub Team', 'Vendor'] + SUM_LABELS
                    + ['Attendance %']):
        header(ws, f'{c}{MT_HDR}', h, 9)
    ws.row_dimensions[MT_HDR].height = 28
    tt = Border(top=S_BOX, bottom=Side(style='medium', color=GREEN), left=S_GRID, right=S_GRID)
    put(ws, f'B{MT_TOT}', 'Total', F(10, True), FILL(GREEN_L), tt, A_C)
    put(ws, f'C{MT_TOT}', f'=COUNT($Q${MT0}:$Q${MT1})&" employees"', F(9, True, color=MUTED), FILL(GREEN_L), tt, A_L)
    for c in 'DEF':
        put(ws, f'{c}{MT_TOT}', None, F(9), FILL(GREEN_L), tt, A_C)
    for c in 'GHIJKL':
        put(ws, f'{c}{MT_TOT}', f'=SUM({c}{MT0}:{c}{MT1})', F(10, True), FILL(GREEN_L), tt, A_C, FMT_CNT)
    put(ws, f'M{MT_TOT}', f'=IF(G{MT_TOT}+H{MT_TOT}=0,"\u2013",G{MT_TOT}/(G{MT_TOT}+H{MT_TOT}))', F(10, True),
        FILL(GREEN_L), tt, A_C, '0.0%')
    off = G0 - 1                                   # month-tab row = master position + off
    for i in range(N_EMP):
        r = MT0 + i
        ws[f'Q{r}'] = f'=IFERROR(MATCH(ROWS($Q${MT0}:Q{r}),Helper!$W$6:$W${5 + N_EMP},0),"")'
        put(ws, f'B{r}', f'=IF($Q{r}="","",INDEX(MasterID,$Q{r}))', F(9), align=A_C)
        for c, nm in zip('CDEF', ['MasterName', 'MasterTeam', 'MasterSub', 'MasterVendor']):
            put(ws, f'{c}{r}', f'=IF($Q{r}="","",INDEX({nm},$Q{r})&"")', F(9), align=A_L if c == 'C' else A_LS)
        for c, sc in zip('GHIJKL', SUMC):
            year = '+'.join(f'IFERROR(N(INDIRECT($P${30 + m}&"{sc}"&($Q{r}+{off}))),0)' for m in range(1, 13))
            put(ws, f'{c}{r}', f'=IF($Q{r}="","",IF(MonthSel="All",{year},'
                               f'IFERROR(N(INDIRECT(SelTab&"{sc}"&($Q{r}+{off}))),0)))', F(9), align=A_C, fmt=FMT_CNT)
        put(ws, f'M{r}', f'=IF($Q{r}="","",IF(G{r}+H{r}=0,"\u2013",G{r}/(G{r}+H{r})))', F(9), align=A_C, fmt='0.0%')

    for r in range(10, 29):
        ws.row_dimensions[r].height = 15
    bar_chart(ws, 'Present vs Leave/ISPL Holiday by month (person-days)', 3, ['4F81BD', 'E3A33B'], 'B12', 15.6)
    bar_chart(ws, 'Early Morning vs Late Evening shifts by month', 5, ['3AA394', '8E7CC3'], 'H12', 14.6)
    cf(ws, 'B6:M6', 'LEFT($B6,1)="\u26a0"', font=CFF(True, color='C0392B'))
    cf(ws, 'B31:K42', 'AND(MonthSel<>"All",$B31=MonthSel)', fill='FFF2CC')
    cf(ws, 'K31:K42', 'LEFT(K31,1)="\u26a0"', font=CFF(True, color='C55A11'))
    cf(ws, 'J31:J42', 'J31="No tab yet"', font=CFF(False, True, '9CA3AF'))
    # member-table look: borders and banding only on listed rows, inactive employees in grey italics
    # (four mutually exclusive rules, so every spreadsheet app shows the same thing)
    mt, q = f'B{MT0}:M{MT1}', f'$Q{MT0}'
    inact, band = f'INDEX(MasterStatus,{q})="Inactive"', 'MOD(ROW(),2)=1'
    grey = CFF(False, True, '9CA3AF')
    cf(ws, mt, f'IF({q}="",FALSE,AND({inact},{band}))', fill='F7F9F8', font=grey, border=B_GRID)
    cf(ws, mt, f'IF({q}="",FALSE,AND({inact},NOT({band})))', font=grey, border=B_GRID)
    cf(ws, mt, f'IF({q}="",FALSE,AND(NOT({inact}),{band}))', fill='F7F9F8', border=B_GRID)
    cf(ws, mt, f'IF({q}="",FALSE,AND(NOT({inact}),NOT({band})))', border=B_GRID)
    ws.freeze_panes = 'A7'
    page(ws, landscape=True, area=f'A1:M{MT1}')
    ws.sheet_view.tabSelected = True
    protect(ws, objects=True)


def build_guide(wb):
