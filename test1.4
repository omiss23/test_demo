# 5. OPTIONAL SAMPLE DATA (preview only)
# =============================================================================
def fill_sample(wb, month_sheets):
    rnd = random.Random(2026)
    y0, today = YEARS[0], date.today()
    cutoff = min(today, date(YEARS[-1], 12, 31)) if today.year >= y0 else date(y0, 9, 30)
    if cutoff < date(y0, 3, 1):
        cutoff = date(y0, 9, 30)
    fixed = {h[1] for h in HOLIDAYS if h[2] != "Flexi"}
    flexi = {h[1] for h in HOLIDAYS if h[2] == "Flexi"}

    def working(dt):
        return dt.weekday() not in WEEKEND_DAYS and dt not in fixed

    def working_days_from(start, n):
        out, dt = [], start
        while len(out) < n:
            if working(dt):
                out.append(dt)
            dt += timedelta(days=1)
        return out

    def monday_on_or_after(dt):
        return dt + timedelta(days=(7 - dt.weekday()) % 7)

    teams = [("AML", "Transaction Monitoring"), ("AML", "Investigations"), ("CTF", "Screening"),
             ("CTF", "Analytics"), ("Sanctions", "L1 Review"), ("Sanctions", "Quality Assurance")]
    managers = {"AML": "Priya Nair", "CTF": "Rohan Mehta", "Sanctions": "Kavita Rao"}
    first = ["Aarav", "Sneha", "Vikram", "Ananya", "Karan", "Meera", "Arjun", "Pooja", "Siddharth", "Neha",
             "Rahul", "Kavya", "Aditya", "Isha", "Nikhil", "Riya", "Yash", "Tanvi", "Omkar", "Shruti",
             "Varun", "Aditi", "Harsh", "Simran", "Manish", "Divya", "Sahil", "Gauri", "Pranav", "Nisha"]
    last = ["Sharma", "Patil", "Iyer", "Kulkarni", "Desai", "Joshi", "Kapoor", "Shinde", "Menon",
            "Gupta", "Pawar", "Reddy", "Bhat"]
    perm_pool = [("WFO", 50), ("WFH", 34), ("NCRW", 2), ("PL", 3), ("SL", 2.5), ("OD", 2), ("CO", 1),
                 ("CFL", 1), ("CSR", 0.4), ("LWP", 0.3), ("A", 0.8)]
    contract_pool = [("WFO", 55), ("WFH", 35), ("NCRW", 2), ("PL", 3), ("SL", 2.5), ("CSR", 0.4), ("A", 1)]

    ws_m = wb[MASTER]
    grid = {}
    for i in range(len(first)):
        team, sub = teams[i % len(teams)]
        etype = "Contract" if i % 7 == 6 else "Permanent"
        bl_status, bl_date, bl_take = "Pending", None, 0
        if etype == "Contract":
            bl_status = "Not Applicable"
        elif i % 4 in (0, 1):
            bl_date = monday_on_or_after(date(y0, 3 + i % 6, 8))
            bl_take = BLOCK_LEAVE_DAYS
            bl_status = "Completed" if working_days_from(bl_date, BLOCK_LEAVE_DAYS)[-1] <= cutoff else "Planned"
        elif i % 4 == 2:
            bl_date, bl_status = monday_on_or_after(date(y0, 12, 1)), "Planned"
        elif i % 8 == 3:
            bl_date, bl_take = monday_on_or_after(date(y0, 7, 6)), 5     # took only part of the block
        values = [f"E{1001 + i}", f"{first[i]} {last[i % len(last)]}", team, sub, etype, managers[team],
                  bl_status, bl_date, rnd.randint(0, 5) if etype == "Permanent" else None]
        for j, v in enumerate(values):
            if v is not None:
                ws_m.cell(row=M_FIRST + i, column=j + 1, value=v)

        codes, weights = zip(*(perm_pool if etype == "Permanent" else contract_pool))
        dt = date(y0, 1, 1)
        while dt <= cutoff:
            if working(dt):
                if i % 5 == 0 and (cutoff - dt).days < 4:
                    pass                                             # left unmarked on purpose
                elif dt in flexi and rnd.random() < 0.4:
                    grid[(i, dt)] = "H"
                else:
                    grid[(i, dt)] = rnd.choices(codes, weights)[0]
            dt += timedelta(days=1)
        if i % 9 == 4:                                               # an NCRW stint
            for wd in working_days_from(date(y0, 6, 1), 8):
                grid[(i, wd)] = "NCRW"
        if bl_take:
            for wd in working_days_from(bl_date, bl_take):
                if wd <= cutoff:
                    grid[(i, wd)] = "PL"
    for (i, dt), code in grid.items():
        if (dt.year, dt.month) in month_sheets:
            wb[month_sheets[(dt.year, dt.month)]].cell(row=MS_FIRST + i, column=DAY1 + dt.day - 1, value=code)


# =============================================================================
# 6. MAIN
# =============================================================================
def main():
    ap = argparse.ArgumentParser(description="Build the attendance tracker workbook")
    ap.add_argument("--out", default=OUTPUT_FILE, help="output .xlsx file name")
    ap.add_argument("--sample", action="store_true", help="fill dummy data to preview the dashboard")
    args = ap.parse_args()
    if sorted(set(YEARS)) != list(YEARS):
        sys.exit("YEARS must be in ascending order without duplicates")

    today = date.today()
    default_year = today.year if today.year in YEARS else YEARS[0]
    default_month = MONTHS[today.month - 1] if today.year in YEARS else "All"

    wb = Workbook()
    wb.remove(wb.active)
    register_styles(wb)
    dash = wb.create_sheet(DASH)                 # first tab
    build_master(wb)
    build_codes(wb)
    build_holidays(wb)
    fixed_days = {h[1] for h in HOLIDAYS if h[2] != "Flexi"}
    month_sheets = {}
    for y in YEARS:
        for m in range(1, 13):
            month_sheets[(y, m)] = build_month(wb, y, m, fixed_days)
            print(f"  built {month_sheets[(y, m)]}")
    build_calc(wb)
    build_data(wb, month_sheets)
    build_dashboard(wb, dash, default_year, default_month)
    for name in (MASTER, CODES_WS, HOL_WS):
        landscape(wb[name])
    if args.sample or SAMPLE_DATA:
        fill_sample(wb, month_sheets)
        print("  sample data added")
    wb.calculation.fullCalcOnLoad = True          # Excel calculates everything when the file opens
    wb.active = 0
    wb.save(args.out)
    print(f"\nDone -> {args.out}\nOpen it in Excel; the Dashboard calculates on open.")


if __name__ == "__main__":
    main()
