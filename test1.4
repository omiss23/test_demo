def build_codes(wb):
    ws = wb.create_sheet(CODES_WS)
    ws.sheet_properties.tabColor = "7F7F7F"
    ws.sheet_view.showGridLines = False
    put(ws, "A1", "Leave & Attendance Codes", F(14, True, GREEN_DARK))
    note(ws, 2, 1, 8,
         "Columns A-E are your code table. Yellow columns F-H drive the dashboard: Category decides "
         "whether a code counts in the Present or Leave totals; Balance Limit is the yearly allowance "
         "used for 'Balance' (blank = no balance shown, e.g. WFH / WFO until you set a yearly figure); "
         "C/F Cap is the most PL days carried into the next year.", height=40)
    header(ws, K_HDR, 1, ["Code", "Meaning", "Applies To", "Annual Entitlement", "Carry Forward?",
                          "Category", "Balance Limit (days/yr)", "C/F Cap (days)"],
           [9, 48, 16, 30, 16, 12, 14, 11])
    for i, (code, meaning, applies, ent, cf, cat, lim, cap, color) in enumerate(CODES):
        r = K_FIRST + i
        put(ws, (r, 1), code, F(10, True), PF(color), AL(), BORDER)
        for c, v in ((2, meaning), (3, applies), (4, ent), (5, cf)):
            put(ws, (r, c), v, F(10), None, AL(), BORDER)
        put(ws, (r, 6), cat, F(10, color=INPUT_BLUE), PF(YELLOW), AL(), BORDER)
        put(ws, (r, 7), lim, F(10, color=INPUT_BLUE), PF(YELLOW), AL(), BORDER, "0")
        put(ws, (r, 8), cap, F(10, color=INPUT_BLUE), PF(YELLOW), AL(), BORDER, "0")

    dv = list_validation('"Present,Leave,Off,Absent"', "Category", "Choose Present, Leave, Off or Absent")
    ws.add_data_validation(dv)
    dv.add(f"F{K_FIRST}:F{K_LAST}")
    dvn = DataValidation(type="decimal", operator="greaterThanOrEqual", formula1="0", allow_blank=True,
                         showErrorMessage=True, errorTitle="Number", error="Enter a number (days) or leave blank")
    ws.add_data_validation(dvn)
    dvn.add(f"G{K_FIRST}:H{K_LAST}")

    put(ws, (K_SET, 1), "Settings", F(12, True, GREEN_DARK))
    merge(ws, K_BL, 1, K_BL, 2)
    put(ws, (K_BL, 1), "Block leave - working days that make one complete block", F(10), None, AL("left"), BORDER)
    put(ws, (K_BL, 2), None, border=BORDER)
    put(ws, (K_BL, 3), BLOCK_LEAVE_DAYS, F(10, True, INPUT_BLUE), PF(YELLOW), AL(), BORDER)
    merge(ws, K_BL + 1, 1, K_BL + 1, 2)
    put(ws, (K_BL + 1, 1), "Weekend days (change WEEKEND_DAYS in the script)", F(10), None, AL("left"), BORDER)
    put(ws, (K_BL + 1, 2), None, border=BORDER)
    put(ws, (K_BL + 1, 3), ", ".join(DOW[d] for d in sorted(WEEKEND_DAYS)), F(10), None, AL(), BORDER)
    note(ws, K_BL + 3, 1, 8,
         "How block leave is counted: 'Used' = Leave-category days (PL, SL, CO ...) marked on the month tabs "
         "from the Block Leave Date until the required working days are over (weekends and non-Flexi holidays "
         "skipped). Status 'Completed' in Employee Master counts it as fully used for that year; "
         "'Not Applicable' removes the requirement for that employee.", height=40)
    ws.freeze_panes = f"A{K_FIRST}"

    S = ref(CODES_WS)
    add_name(wb, "CodeList", f"{S}$A${K_FIRST}:$A${K_LAST}")
    add_name(wb, "CodeApplies", f"{S}$C${K_FIRST}:$C${K_LAST}")
    add_name(wb, "CodeCat", f"{S}$F${K_FIRST}:$F${K_LAST}")
    for i, cd in enumerate(CODES):
        add_name(wb, f"LIM_{cd[0]}", f"{S}$G${K_FIRST + i}")
    add_name(wb, "PL_CF_CAP", f"{S}$H${K_FIRST + CODE_IDX['PL']}")
    add_name(wb, "BL_REQ", f"{S}$C${K_BL}")


def build_holidays(wb):
    ws = wb.create_sheet(HOL_WS)
    ws.sheet_properties.tabColor = "7F7F7F"
    ws.sheet_view.showGridLines = False
    put(ws, "A1", "Holiday Calendar", F(14, True, GREEN_DARK))
    note(ws, 2, 1, 5,
         "Add next year's holidays in the empty rows. Non-Flexi holidays are shaded orange on the month "
         "tabs and skipped when counting block-leave working days; Flexi holidays are shaded light orange "
         "(mark H only for employees who avail them). 'H' is pre-filled only for holidays that were listed "
         "here when the script ran - for holidays added later, mark H yourself.", height=52)
    header(ws, H_HDR, 1, ["Holiday", "Date", "Day", "Type", "Applies To"], [42, 15, 8, 28, 16])
    put(ws, (H_HDR, 7), "Fixed date (helper)", F(9, True))
    hols = sorted(HOLIDAYS, key=lambda h: h[1])
    for i in range(H_SLOTS):
        r = H_FIRST + i
        name, d, typ, applies = hols[i] if i < len(hols) else (None, None, None, None)
        put(ws, (r, 1), name, F(10), None, AL("left"), BORDER)
        put(ws, (r, 2), d, F(10), None, AL(), BORDER, DATE_FMT)
        put(ws, (r, 3), f'=IF(ISNUMBER(B{r}),B{r},"")', F(10, color=GREY_TXT), None, AL(), BORDER, "ddd")
        put(ws, (r, 4), typ, F(10), None, AL(), BORDER)
        put(ws, (r, 5), applies, F(10), None, AL(), BORDER)
        put(ws, (r, 7), f'=IF(AND(ISNUMBER(B{r}),D{r}<>"Flexi"),B{r},0)', fmt=DATE_FMT)
    ws.column_dimensions["G"].hidden = True

    dvd = DataValidation(type="date", operator="greaterThan", formula1=str(serial(date(2000, 1, 1))),
                         allow_blank=True, showErrorMessage=True, errorTitle="Date",
                         error="Enter a valid date, e.g. 26-01-2027")
    dvt = list_validation('"' + ",".join(HOLIDAY_TYPES) + '"', "Type", "Choose a holiday type")
    dva = list_validation('"All Employees,Permanent Only,Contract Only"', "Applies To", "Choose from the list")
    for dv, col in ((dvd, "B"), (dvt, "D"), (dva, "E")):
        ws.add_data_validation(dv)
        dv.add(f"{col}{H_FIRST}:{col}{H_LAST}")
    ws.freeze_panes = f"A{H_FIRST}"

    S = ref(HOL_WS)
    add_name(wb, "HolDates", f"{S}$B${H_FIRST}:$B${H_LAST}")
    add_name(wb, "HolTypes", f"{S}$D${H_FIRST}:$D${H_LAST}")
    add_name(wb, "FixedHolidays", f"{S}$G${H_FIRST}:$G${H_LAST}")


def build_master(wb):
    ws = wb.create_sheet(MASTER)
    ws.sheet_properties.tabColor = "2F75B5"
    ws.sheet_view.showGridLines = False
    put(ws, "A1", "Employee Master", F(14, True, GREEN_DARK))
    note(ws, 2, 1, 9,
         f"One employee per row in rows {M_FIRST}-{M_LAST}. The month tabs read this sheet row by row, so "
         "add new joiners at the bottom and don't sort or delete rows once attendance is entered (clear a "
         "leaver's row only after their attendance no longer matters). Grey row 3 is just an example.",
         height=30)
    example = ["e.g. E1001", "Rahul Sharma", "AML", "Transaction Monitoring", "Permanent", "Priya Nair",
               "Planned", date(YEARS[0], 12, 7), 2]
    for j, v in enumerate(example):
        put(ws, (3, j + 1), v, F(9, italic=True, color="A6A6A6"),
            align=AL("left" if j in (0, 1, 2, 3, 5) else "center"), fmt=DATE_FMT if j == 7 else None)
    header(ws, M_HDR, 1, ["Emp ID", "Employee Name", "Team", "Sub Team", "Employment Type", "Manager",
                          "Block Leave Status", "Block Leave Date", f"Opening PL C/F into {YEARS[0]} (optional)"],
           [13, 26, 18, 24, 16, 22, 18, 16, 17])
    for r in range(M_FIRST, M_LAST + 1):
        for c in range(1, 10):
            cell = ws.cell(row=r, column=c)
            cell.style = "inp"
            if c in (5, 7, 8, 9):
                cell.alignment = AL()
            if c == 8:
                cell.number_format = DATE_FMT

    dvs = [
        (list_validation('"' + ",".join(EMPLOYMENT_TYPES) + '"', "Employment type",
                         "Choose Permanent or Contract"), "E"),
        (list_validation('"' + ",".join(BLOCK_LEAVE_STATUSES) + '"', "Block leave status",
                         "Choose a status from the list"), "G"),
        (DataValidation(type="date", operator="greaterThan", formula1=str(serial(date(2000, 1, 1))),
                        allow_blank=True, showErrorMessage=True, errorTitle="Date",
                        error="Enter the block leave start date, e.g. 07-12-2026"), "H"),
        (DataValidation(type="whole", operator="between", formula1="0", formula2="365", allow_blank=True,
                        showErrorMessage=True, errorTitle="PL carry forward",
                        error="Enter whole days (it is capped by the C/F Cap on the Leave Codes sheet)"), "I"),
    ]
    for dv, col in dvs:
        ws.add_data_validation(dv)
        dv.add(f"{col}{M_FIRST}:{col}{M_LAST}")

    ws.conditional_formatting.add(
        f"A{M_FIRST}:A{M_LAST}",
        FormulaRule(formula=[f'AND($A{M_FIRST}<>"",COUNTIF($A${M_FIRST}:$A${M_LAST},$A{M_FIRST})>1)'],
                    fill=PF("FFC7CE"), font=Font(color="9C0006", bold=True)))
    ws.freeze_panes = f"C{M_FIRST}"


def build_month(wb, year, month, fixed_days):
    name = f"{MONTHS[month - 1]}-{year}"
    ws = wb.create_sheet(name)
    ws.sheet_properties.tabColor = "A9D08E"
    ndays = calendar.monthrange(year, month)[1]
    lastcol = DAY1 + ndays - 1
    M, CA = ref(MASTER), ref(CALC)

    # Title, how-to, legend
    merge(ws, 1, 1, 1, 5)
    put(ws, (1, 1), f"{MONTHS_FULL[month - 1]} {year} - Attendance", F(14, True, GREEN_DARK), align=AL("left"))
    merge(ws, 1, DAY1, 1, DAYN)
    put(ws, (1, DAY1),
        "Pick a code from the dropdown in each day cell  •  WO and fixed holidays are pre-filled  •  "
        "light-orange date = Flexi holiday (mark H only if availed)  •  yellow date = today  •  "
        "red code = not allowed for Contract staff",
        F(8, italic=True, color=GREY_TXT), align=AL("left"))
    ws.row_dimensions[1].height = 24
    put(ws, (MS_LEGEND, 5), "Legend", F(8, True, GREY_TXT), align=AL("right"))
    for i, cd in enumerate(CODES):
        put(ws, (MS_LEGEND, DAY1 + i), cd[0], F(7, True), PF(cd[8]), AL(), BORDER)
    merge(ws, MS_LEGEND, S1, MS_LEGEND, S_BL)
    put(ws, (MS_LEGEND, S1), "Monthly count per code (row 5 = category used for the totals)",
        F(8, italic=True, color=GREY_TXT), align=AL("left"))
    merge(ws, MS_PRES, 1, MS_PRES, 5)
    put(ws, (MS_PRES, 1), "Present (count per day)", F(9, True, "375623"), align=AL("right"))
    merge(ws, MS_LEAVE, 1, MS_LEAVE, 5)
    put(ws, (MS_LEAVE, 1), "On leave (count per day)", F(9, True, "833C0B"), align=AL("right"))

    # Column headers
    for i, (h, w) in enumerate(zip(["Emp ID", "Employee Name", "Team", "Sub Team", "Type"], [10, 24, 13, 16, 10])):
        put(ws, (MS_HDR, 1 + i), h, F(9, True, "FFFFFF"), PF(GREEN), AL(wrap=True), BORDER)
        ws.column_dimensions[CL(1 + i)].width = w
    for d in range(1, 32):
        col = DAY1 + d - 1
        L = CL(col)
        ws.column_dimensions[L].width = 4.7
        if d > ndays:
            ws.column_dimensions[L].hidden = True
            continue
        dt = date(year, month, d)
        hfill = PF("595959") if dt.weekday() in WEEKEND_DAYS else PF(GREEN)
        put(ws, (MS_DOW, col), DOW[dt.weekday()], F(8, True, "FFFFFF"), hfill, AL(), BORDER)
        put(ws, (MS_HDR, col), dt, F(9, True, "FFFFFF"), hfill, AL(), BORDER, "d")
        col_rng = f"{L}${MS_FIRST}:{L}${MS_LAST}"
        put(ws, (MS_PRES, col), f'=SUMPRODUCT(COUNTIF({col_rng},CodeList)*(CodeCat="Present"))',
            F(8, color="375623"), align=AL(), fmt=ZERO_BLANK)
        put(ws, (MS_LEAVE, col), f'=SUMPRODUCT(COUNTIF({col_rng},CodeList)*(CodeCat="Leave"))',
            F(8, color="833C0B"), align=AL(), fmt=ZERO_BLANK)
    for j, cd in enumerate(CODES):
        col = S1 + j
        L = CL(col)
        put(ws, (MS_HDR, col), cd[0], F(8, True), PF(cd[8]), AL(), BORDER)
        put(ws, (MS_DOW, col), f'=IFERROR(INDEX(CodeCat,MATCH({L}${MS_HDR},CodeList,0)),"")',
            F(7, italic=True, color=GREY_TXT), align=AL())
        ws.column_dimensions[L].width = 5.3
    for col, label in ((S_PRES, "Present"), (S_LEAVE, "Leave"), (S_UNM, "Unmarked (till today)"),
                       (S_BL, "Block Leave days")):
        put(ws, (MS_HDR, col), label, F(8, True, "FFFFFF"), PF(GREEN_DARK), AL(wrap=True), BORDER)
        ws.column_dimensions[CL(col)].width = 9.5
    ws.row_dimensions[MS_HDR].height = 30

    # Employee rows
    dates = f"${CL(DAY1)}${MS_HDR}:${CL(DAYN)}${MS_HDR}"
    dows = f"${CL(DAY1)}${MS_DOW}:${CL(DAYN)}${MS_DOW}"
    cats = f"${CL(S1)}${MS_DOW}:${CL(SN)}${MS_DOW}"
    weekday_only = "".join(f'*({dows}<>"{DOW[w]}")' for w in sorted(WEEKEND_DAYS))
    bl_end_col = CL(C_BLEND)
    for i in range(MAX_EMPLOYEES):
        r, mr, cr = MS_FIRST + i, M_FIRST + i, C_FIRST + i
        ws.cell(row=r, column=1, value=f'=IF({M}$A{mr}="","",{M}$A{mr})').style = "txt"
        for c, mc in ((2, "B"), (3, "C"), (4, "D"), (5, "E")):
            ws.cell(row=r, column=c, value=f'=IF($A{r}="","",{M}${mc}{mr}&"")').style = "txt"
        for d in range(1, ndays + 1):
            cell = ws.cell(row=r, column=DAY1 + d - 1)
            cell.style = "grid"
            dt = date(year, month, d)
            if PREFILL_WEEK_OFF and dt.weekday() in WEEKEND_DAYS:
                cell.value = "WO"
            elif PREFILL_HOLIDAYS and dt in fixed_days:
                cell.value = "H"
        row_rng = f"${CL(DAY1)}{r}:${CL(DAYN)}{r}"
        for j in range(NC):
            col = S1 + j
            ws.cell(row=r, column=col,
                    value=f'=IF($A{r}="","",COUNTIF({row_rng},{CL(col)}${MS_HDR}))').style = "cnt"
        cnt_rng = f"${CL(S1)}{r}:${CL(SN)}{r}"
        ws.cell(row=r, column=S_PRES, value=f'=IF($A{r}="","",SUMIF({cats},"Present",{cnt_rng}))').style = "cntb"
        ws.cell(row=r, column=S_LEAVE, value=f'=IF($A{r}="","",SUMIF({cats},"Leave",{cnt_rng}))').style = "cntb"
        ws.cell(row=r, column=S_UNM,
                value=f'=IF($A{r}="","",SUMPRODUCT(({dates}<>"")*({dates}<=TODAY()){weekday_only}'
                      f'*({row_rng}="")))').style = "cnt"
        ws.cell(row=r, column=S_BL,
                value=f'=IF(OR($A{r}="",{CA}${bl_end_col}{cr}=""),"",SUMPRODUCT(({dates}>={M}$H{mr})'
                      f'*({dates}<={CA}${bl_end_col}{cr})*(COUNTIFS(CodeList,{row_rng},CodeCat,"Leave")>0)))'
                ).style = "cnt"

    # Conditional formatting: empty rows greyed, code colours, contract misuse, holiday/today headers
    grid = f"{CL(DAY1)}{MS_FIRST}:{CL(lastcol)}{MS_LAST}"
    ws.conditional_formatting.add(
        grid, FormulaRule(formula=[f'$A{MS_FIRST}=""'], stopIfTrue=True, font=Font(color="BFBFBF")))
    for cd in CODES:
        ws.conditional_formatting.add(
            grid, CellIsRule(operator="equal", formula=[f'"{cd[0]}"'], fill=PF(cd[8]),
                             font=Font(bold=True) if cd[0] == "A" else None))
    ws.conditional_formatting.add(
        grid, FormulaRule(formula=[f'AND($E{MS_FIRST}="Contract",'
                                   f'COUNTIFS(CodeList,{CL(DAY1)}{MS_FIRST},CodeApplies,"Permanent Only")>0)'],
                          font=Font(color="C00000", bold=True), border=RED_BORDER))
    hdr = f"{CL(DAY1)}{MS_DOW}:{CL(lastcol)}{MS_HDR}"
    a = f"{CL(DAY1)}${MS_HDR}"
    ws.conditional_formatting.add(
        hdr, FormulaRule(formula=[f"{a}=TODAY()"], stopIfTrue=True, fill=PF("FFFF00"),
                         font=Font(color="000000", bold=True)))
    ws.conditional_formatting.add(
        hdr, FormulaRule(formula=[f'AND({a}<>"",COUNTIFS(HolDates,{a},HolTypes,"<>Flexi")>0)'],
                         fill=PF("F4B183"), font=Font(color="000000", bold=True)))
    ws.conditional_formatting.add(
        hdr, FormulaRule(formula=[f'AND({a}<>"",COUNTIFS(HolDates,{a},HolTypes,"Flexi")>0)'],
                         fill=PF("FCE4D6"), font=Font(color="000000", bold=True)))

    dv = list_validation("CodeList", "Invalid code", "Pick a code from the list (see the Leave Codes sheet).")
    ws.add_data_validation(dv)
    dv.add(grid)
    ws.freeze_panes = f"{CL(DAY1)}{MS_FIRST}"
    landscape(ws)
    return name


def build_calc(wb):
    ws = wb.create_sheet(CALC)
    ws.sheet_state = "hidden"
    M, D = ref(MASTER), ref(DASH)
    put(ws, "A1", "Helper sheet for the Dashboard - calculated automatically, do not edit.", F(10, True))
    heads = {C_SLOT: "Slot", C_ID: "Emp ID", C_TEAM: "Team", C_SUB: "Sub Team", C_MATCH: "In filter",
             C_EMPSEQ: "Emp #", C_TEAMSEQ: "Team #", C_SUBSEQ: "Team+Sub #", C_TEAMALL: "Team list #",
             C_SUBFILT: "Sub list #", C_BLREQ: "BL required", C_BLEND: "BL end date",
             C_BLAUTO: "BL days (attendance, YTD)", C_BLUSED: "BL used", C_BLBAL: "BL balance",
             C_BLDONE: "BL done", C_BLPEND: "BL pending", C_PLCFSEL: "PL C/F (selected year)",
             C_L_TEAM: "Team filter list", C_L_SUB: "Sub team filter list", C_L_YEAR: "Years",
             C_L_MONTH: "Months", C_SEL_LBL: "Selection", C_SEL_VAL: "Value"}
    for j, y in enumerate(YEARS):
        heads[C_PLU + j] = f"PL used {y}"
        heads[C_PLCF + j] = f"PL C/F into {y}"
    for col, h in heads.items():
        put(ws, (C_HDR, col), h, F(9, True))

    lID, lTEAM, lSUB, lMATCH = CL(C_ID), CL(C_TEAM), CL(C_SUB), CL(C_MATCH)
    lTSEQ, lSSEQ, lTALL, lSFILT = CL(C_TEAMSEQ), CL(C_SUBSEQ), CL(C_TEAMALL), CL(C_SUBFILT)
    lREQ, lAUTO, lUSED, lBAL = CL(C_BLREQ), CL(C_BLAUTO), CL(C_BLUSED), CL(C_BLBAL)
    f0 = C_FIRST
    for i in range(MAX_EMPLOYEES):
        r, mr, k = C_FIRST + i, M_FIRST + i, i + 1
        blank = f'${lID}{r}=""'
        ws.cell(row=r, column=C_SLOT, value=k)
        ws.cell(row=r, column=C_ID, value=f'=IF(TRIM({M}$A{mr}&"")="","",{M}$A{mr})')
        ws.cell(row=r, column=C_TEAM,
                value=f'=IF({blank},"",IF(TRIM({M}$C{mr}&"")="","(Blank)",TRIM({M}$C{mr}&"")))')
        ws.cell(row=r, column=C_SUB,
                value=f'=IF({blank},"",IF(TRIM({M}$D{mr}&"")="","(Blank)",TRIM({M}$D{mr}&"")))')
        ws.cell(row=r, column=C_MATCH,
                value=f'=IF({blank},0,IF(AND(OR(selTeam="All",${lTEAM}{r}=selTeam),'
                      f'OR(selSub="All",${lSUB}{r}=selSub)),1,0))')
        ws.cell(row=r, column=C_EMPSEQ, value=f'=IF(${lMATCH}{r}=1,COUNTIF(${lMATCH}${f0}:${lMATCH}{r},1),"")')
        ws.cell(row=r, column=C_TEAMSEQ,
                value=f'=IF(${lMATCH}{r}=1,IF(COUNTIFS(${lTEAM}${f0}:${lTEAM}{r},${lTEAM}{r},'
                      f'${lMATCH}${f0}:${lMATCH}{r},1)=1,MAX(${lTSEQ}${C_HDR}:${lTSEQ}{r - 1})+1,""),"")')
        ws.cell(row=r, column=C_SUBSEQ,
                value=f'=IF(${lMATCH}{r}=1,IF(COUNTIFS(${lTEAM}${f0}:${lTEAM}{r},${lTEAM}{r},'
                      f'${lSUB}${f0}:${lSUB}{r},${lSUB}{r},${lMATCH}${f0}:${lMATCH}{r},1)=1,'
                      f'MAX(${lSSEQ}${C_HDR}:${lSSEQ}{r - 1})+1,""),"")')
        ws.cell(row=r, column=C_TEAMALL,
                value=f'=IF({blank},"",IF(COUNTIF(${lTEAM}${f0}:${lTEAM}{r},${lTEAM}{r})=1,'
                      f'MAX(${lTALL}${C_HDR}:${lTALL}{r - 1})+1,""))')
        ws.cell(row=r, column=C_SUBFILT,
                value=f'=IF({blank},"",IF(OR(selTeam="All",${lTEAM}{r}=selTeam),IF(IF(selTeam="All",'
                      f'COUNTIF(${lSUB}${f0}:${lSUB}{r},${lSUB}{r}),COUNTIFS(${lSUB}${f0}:${lSUB}{r},${lSUB}{r},'
                      f'${lTEAM}${f0}:${lTEAM}{r},selTeam))=1,MAX(${lSFILT}${C_HDR}:${lSFILT}{r - 1})+1,""),""))')
        # Block leave
        ws.cell(row=r, column=C_BLREQ,
                value=f'=IF({blank},"",IF({M}$G{mr}="Not Applicable",0,BL_REQ))')
        ws.cell(row=r, column=C_BLEND,
                value=f'=IF(OR({blank},NOT(ISNUMBER({M}$H{mr}))),"",WORKDAY({M}$H{mr}-1,BL_REQ,FixedHolidays))'
                ).number_format = DATE_FMT
        ws.cell(row=r, column=C_BLAUTO,
                value=f'=IF({blank},"",SUMIFS(dBL,dSlot,$A{r},dYear,selYear,dMonth,"<="&ytdMonth))')
        ws.cell(row=r, column=C_BLUSED,
                value=f'=IF({blank},"",IF(${lREQ}{r}=0,0,IF(AND({M}$G{mr}="Completed",'
                      f'OR(NOT(ISNUMBER({M}$H{mr})),YEAR(N({M}$H{mr}))=selYear)),${lREQ}{r},'
                      f'MIN(${lREQ}{r},${lAUTO}{r}))))')
        ws.cell(row=r, column=C_BLBAL, value=f'=IF({blank},"",${lREQ}{r}-${lUSED}{r})')
        ws.cell(row=r, column=C_BLDONE, value=f'=IF({blank},"",IF(AND(${lREQ}{r}>0,${lBAL}{r}<=0),1,0))')
        ws.cell(row=r, column=C_BLPEND, value=f'=IF({blank},"",IF(${lBAL}{r}>0,1,0))')
        # PL carry forward chain
        for j, y in enumerate(YEARS):
            ws.cell(row=r, column=C_PLU + j, value=f'=IF({blank},"",SUMIFS(d_PL,dSlot,$A{r},dYear,{y}))')
            if j == 0:
                cf = f'=IF({blank},"",MIN(PL_CF_CAP,MAX(0,N({M}$I{mr}))))'
            else:
                cf = (f'=IF({blank},"",MIN(PL_CF_CAP,MAX(0,N(LIM_PL)+${CL(C_PLCF + j - 1)}{r}'
                      f'-${CL(C_PLU + j - 1)}{r})))')
            ws.cell(row=r, column=C_PLCF + j, value=cf)
        ws.cell(row=r, column=C_PLCFSEL,
                value=f'=IF({blank},"",IF(selYearIdx=0,0,INDEX(${CL(C_PLCF)}{r}:${CL(C_PLCF + NY - 1)}{r},'
                      f'1,selYearIdx)))')

    # Dropdown lists
    ws.cell(row=C_FIRST, column=C_L_TEAM, value="All")
    ws.cell(row=C_FIRST, column=C_L_SUB, value="All")
    for k in range(1, MAX_EMPLOYEES + 1):
        r = C_FIRST + k
        ws.cell(row=r, column=C_L_TEAM,
                value=f'=IFERROR(INDEX(${lTEAM}${C_FIRST}:${lTEAM}${C_LAST},'
                      f'MATCH({k},${lTALL}${C_FIRST}:${lTALL}${C_LAST},0)),"")')
        ws.cell(row=r, column=C_L_SUB,
                value=f'=IFERROR(INDEX(${lSUB}${C_FIRST}:${lSUB}${C_LAST},'
                      f'MATCH({k},${lSFILT}${C_FIRST}:${lSFILT}${C_LAST},0)),"")')
    for j, y in enumerate(YEARS):
        ws.cell(row=C_FIRST + j, column=C_L_YEAR, value=y)
    ws.cell(row=C_FIRST, column=C_L_MONTH, value="All")
    for m in range(12):
        ws.cell(row=C_FIRST + 1 + m, column=C_L_MONTH, value=MONTHS[m])

    # Selected filters (read from the Dashboard)
    selections = [
        ("selYear", f'=IFERROR(VALUE({D}${DF_YEAR[0]}${DF_YEAR[1:]}&""),{YEARS[0]})'),
        ("selMonth", f'=IFERROR(MATCH({D}${DF_MONTH[0]}${DF_MONTH[1:]}&"",MonthNames,0),0)'),
        ("ytdMonth", "=IF(selMonth=0,12,selMonth)"),
        ("selTeam", f'=IF(TRIM({D}${DF_TEAM[0]}${DF_TEAM[1:]}&"")="","All",TRIM({D}${DF_TEAM[0]}${DF_TEAM[1:]}&""))'),
        ("selSub", f'=IF(TRIM({D}${DF_SUB[0]}${DF_SUB[1:]}&"")="","All",TRIM({D}${DF_SUB[0]}${DF_SUB[1:]}&""))'),
        ("selYearIdx", "=IFERROR(MATCH(selYear,YearList,0),0)"),
    ]
    CA = ref(CALC)
    for i, (nm, formula) in enumerate(selections):
        r = C_FIRST + i
        ws.cell(row=r, column=C_SEL_LBL, value=nm)
        ws.cell(row=r, column=C_SEL_VAL, value=formula)
        add_name(wb, nm, f"{CA}${CL(C_SEL_VAL)}${r}")

    add_name(wb, "YearList", f"{CA}${CL(C_L_YEAR)}${C_FIRST}:${CL(C_L_YEAR)}${C_FIRST + NY - 1}")
    add_name(wb, "MonthList", f"{CA}${CL(C_L_MONTH)}${C_FIRST}:${CL(C_L_MONTH)}${C_FIRST + 12}")
    add_name(wb, "MonthNames", f"{CA}${CL(C_L_MONTH)}${C_FIRST + 1}:${CL(C_L_MONTH)}${C_FIRST + 12}")
    add_name(wb, "TeamFilterList", f"OFFSET({CA}${CL(C_L_TEAM)}${C_FIRST},0,0,"
                                   f"1+MAX({CA}${lTALL}${C_FIRST}:${lTALL}${C_LAST}),1)")
    add_name(wb, "SubFilterList", f"OFFSET({CA}${CL(C_L_SUB)}${C_FIRST},0,0,"
                                  f"1+MAX({CA}${lSFILT}${C_FIRST}:${lSFILT}${C_LAST}),1)")
    for nm, col in (("cTeam", C_TEAM), ("cSub", C_SUB), ("cMatch", C_MATCH), ("cEmpSeq", C_EMPSEQ),
                    ("cTeamSeq", C_TEAMSEQ), ("cSubSeq", C_SUBSEQ), ("cBLReq", C_BLREQ),
                    ("cBLUsed", C_BLUSED), ("cBLBal", C_BLBAL), ("cBLDone", C_BLDONE),
                    ("cBLPend", C_BLPEND), ("cPLCF", C_PLCFSEL)):
        add_name(wb, nm, f"{CA}${CL(col)}${C_FIRST}:${CL(col)}${C_LAST}")


def build_data(wb, month_sheets):
    ws = wb.create_sheet(DATA)
    ws.sheet_state = "hidden"
    CA = ref(CALC)
    ws.append(["Year", "MonthNo", "Month", "Slot", "Emp ID", "Team", "Sub Team", "In filter"]
              + [c[0] for c in CODES]
              + ["Present", "Leave", "Unmarked", "BL days", "In period", "In YTD"])
    lID, lTEAM, lSUB, lMATCH = CL(C_ID), CL(C_TEAM), CL(C_SUB), CL(C_MATCH)
    d = D_FIRST
    for y in YEARS:
        for m in range(1, 13):
            S = ref(month_sheets[(y, m)])
            for k in range(1, MAX_EMPLOYEES + 1):
                cr, sr = C_FIRST + k - 1, MS_FIRST + k - 1
                row = [y, m, MONTHS[m - 1], k,
                       f"={CA}${lID}${cr}", f"={CA}${lTEAM}${cr}", f"={CA}${lSUB}${cr}", f"={CA}${lMATCH}${cr}"]
                row += [f"={S}{CL(S1 + j)}{sr}" for j in range(NC)]
                row += [f"={S}{CL(c)}{sr}" for c in (S_PRES, S_LEAVE, S_UNM, S_BL)]
                row += [f"=IF(AND($H{d}=1,$A{d}=selYear,OR(selMonth=0,$B{d}=selMonth)),1,0)",
                        f"=IF(AND($H{d}=1,$A{d}=selYear,$B{d}<=ytdMonth),1,0)"]
                ws.append(row)
                d += 1

    DS = ref(DATA)

    def col_name(nm, col):
        add_name(wb, nm, f"{DS}${CL(col)}${D_FIRST}:${CL(col)}${D_LAST}")

    for nm, col in (("dYear", D_YEAR), ("dMonth", D_MON), ("dSlot", D_SLOT), ("dTeam", D_TEAM),
                    ("dSub", D_SUB), ("dMatch", D_MATCH), ("dPresent", D_PRES), ("dLeave", D_LEAVE),
                    ("dUnmarked", D_UNM), ("dBL", D_BL), ("dInPeriod", D_INP), ("dInYTD", D_YTD)):
        col_name(nm, col)
    for j, cd in enumerate(CODES):
        col_name(f"d_{cd[0]}", D_CODE1 + j)


def build_dashboard(wb, ws, default_year, default_month):
    M = ref(MASTER)
    ws.sheet_properties.tabColor = GREEN
    ws.sheet_view.showGridLines = False
    widths = dict(A=4, B=12, C=24, D=14, E=18, F=10, G=10, H=10, I=13, J=12, K=10, L=10, M=16, N=22,
                  O=10, P=10, Q=10, R=10, S=10, T=10, U=10, V=10)
    for col, w in widths.items():
        ws.column_dimensions[col].width = w
    ws.column_dimensions["A"].hidden = True          # helper: employee slot numbers

    NT = max(TEAM_ROWS, SUBTEAM_ROWS)
    R_CARD = 7
    R_SEC1, R_TH1, R_T1 = 11, 12, 13
    R_WARN = R_T1 + NT
    R_SEC2 = R_WARN + 2
    R_TH2, R_T2 = R_SEC2 + 1, R_SEC2 + 2
    R_T2_TOT = R_T2 + 12
    R_SEC3 = R_T2_TOT + 2
    R_GH3, R_TH3, R_T3 = R_SEC3 + 1, R_SEC3 + 2, R_SEC3 + 3
    R_T3_LAST = R_T3 + MAX_EMPLOYEES - 1
    sec_font = F(12, True, GREEN_DARK)

    # ---- Title & filters
    put(ws, "B1", "Attendance Dashboard", F(18, True, GREEN_DARK))
    note(ws, 2, 2, 22,
         "Change the yellow filters.  Period figures follow the Month filter (All = whole year).  "
         "Leave balances and block leave are year-to-date up to the selected month.")
    for lbl_cell, label, val_cell, value, merge_to in (
            ("B3", "Year", DF_YEAR, default_year, None),
            ("E3", "Month", DF_MONTH, default_month, None),
            ("H3", "Team", DF_TEAM, "All", "J3"),
            ("L3", "Sub Team", DF_SUB, "All", "N3")):
        put(ws, lbl_cell, label, F(10, True, GREEN_DARK), align=AL("right"))
        if merge_to:
            ws.merge_cells(f"{val_cell}:{merge_to}")
        put(ws, val_cell, value, F(11, True, INPUT_BLUE), PF(YELLOW), AL(), BORDER, "0")
        if merge_to:
            for c in ws[f"{val_cell}:{merge_to}"][0]:
                c.border = BORDER
    ws.row_dimensions[3].height = 22
    for source, cell in (("YearList", DF_YEAR), ("MonthList", DF_MONTH),
                         ("TeamFilterList", DF_TEAM), ("SubFilterList", DF_SUB)):
        dv = list_validation(source, "Filter", "Pick a value from the dropdown list")
        ws.add_data_validation(dv)
        dv.add(cell)
    merge(ws, 5, 2, 5, 22)
    put(ws, "B5",
        '="Period: "&IF(selMonth=0,"Jan-Dec "&selYear,INDEX(MonthNames,selMonth)&" "&selYear)'
        '&"     |     Balances & block leave: year-to-date "'
        '&IF(ytdMonth=1,"Jan","Jan-"&INDEX(MonthNames,ytdMonth))&" "&selYear'
        '&IF(SUM(cMatch)=0,"     |     No employees match these filters","")',
        F(10, True, "375623"), PF(GREEN_LIGHT), AL("left"))

    # ---- KPI cards
    cards = [
        ("Headcount", "=SUM(cMatch)",
         '=IF(selTeam="All","All teams",selTeam)&IF(selSub="All",""," > "&selSub)', GREEN_DARK),
        ("Present Days", "=SUMIFS(dPresent,dInPeriod,1)",
         '="WFO "&SUMIFS(d_WFO,dInPeriod,1)&" | WFH "&SUMIFS(d_WFH,dInPeriod,1)'
         '&" | NCRW "&SUMIFS(d_NCRW,dInPeriod,1)&" | OD "&SUMIFS(d_OD,dInPeriod,1)', "375623"),
        ("Leave Days", "=SUMIFS(dLeave,dInPeriod,1)",
         '="PL "&SUMIFS(d_PL,dInPeriod,1)&" | SL "&SUMIFS(d_SL,dInPeriod,1)&" | Others "'
         '&(SUMIFS(dLeave,dInPeriod,1)-SUMIFS(d_PL,dInPeriod,1)-SUMIFS(d_SL,dInPeriod,1))', "1F4E79"),
        ("Absent Days", "=SUMIFS(d_A,dInPeriod,1)", "Days marked A - follow up", "C00000"),
        ("Unmarked Days", "=SUMIFS(dUnmarked,dInPeriod,1)", "Working days left blank (till today)", "BF8F00"),
        ("Block Leave Done", "=SUMIFS(cBLDone,cMatch,1)",
         '="of "&COUNTIFS(cMatch,1,cBLReq,">0")&" employees | "&SUMIFS(cBLUsed,cMatch,1)&" days used"', "375623"),
        ("Block Leave Pending", "=SUMIFS(cBLPend,cMatch,1)",
         '=SUMIFS(cBLBal,cMatch,1)&" days still to be taken"', "C55A11"),
    ]
    spans = [(2, 3), (4, 6), (7, 9), (10, 12), (13, 14), (15, 18), (19, 22)]   # similar card widths
    for (label, value, sub, color), (c1, c2) in zip(cards, spans):
        for rr in (R_CARD, R_CARD + 1, R_CARD + 2):
            merge(ws, rr, c1, rr, c2)
        put(ws, (R_CARD, c1), label, F(10, True, "FFFFFF"), PF(color), AL())
        put(ws, (R_CARD + 1, c1), value, F(22, True, color), PF("F7F9F5"), AL(), fmt="#,##0")
        put(ws, (R_CARD + 2, c1), sub, F(8, italic=True, color="595959"), PF("F7F9F5"), AL(wrap=True))
    ws.row_dimensions[R_CARD + 1].height = 36
    ws.row_dimensions[R_CARD + 2].height = 24

    # ---- Team-wise & Sub-team-wise tables
    put(ws, (R_SEC1, 2), "Team-wise Summary", sec_font)
    put(ws, (R_SEC1, 13), "Sub Team-wise Summary", sec_font)
    merge(ws, R_TH1, 2, R_TH1, 3)
    header(ws, R_TH1, 2, ["Team"], size=9)
    header(ws, R_TH1, 4, ["Head-count", "Present (days)", "Leave (days)", "Absent (days)",
                          "Block Leave Used (days)", "Block Leave Balance (days)", "BL Done (emp)",
                          "BL Pending (emp)"], size=9, height=42)
    header(ws, R_TH1, 13, ["Team", "Sub Team", "Head-count", "Present (days)", "Leave (days)",
                           "Absent (days)", "Block Leave Used (days)", "Block Leave Balance (days)",
                           "BL Done (emp)", "BL Pending (emp)"], size=9, height=42)
    for i in range(TEAM_ROWS):
        r, k = R_T1 + i, i + 1
        merge(ws, r, 2, r, 3)
        t = f"$B{r}"
        put(ws, (r, 2), f'=IFERROR(INDEX(cTeam,MATCH({k},cTeamSeq,0)),"")', F(10, True), align=AL("left"))
        formulas = [f"COUNTIFS(cTeam,{t},cMatch,1)",
                    f"SUMIFS(dPresent,dTeam,{t},dInPeriod,1)",
                    f"SUMIFS(dLeave,dTeam,{t},dInPeriod,1)",
                    f"SUMIFS(d_A,dTeam,{t},dInPeriod,1)",
                    f"SUMIFS(cBLUsed,cTeam,{t},cMatch,1)",
                    f"SUMIFS(cBLBal,cTeam,{t},cMatch,1)",
                    f"SUMIFS(cBLDone,cTeam,{t},cMatch,1)",
                    f"SUMIFS(cBLPend,cTeam,{t},cMatch,1)"]
        for j, fx in enumerate(formulas):
            put(ws, (r, 4 + j), f'=IF({t}="","",{fx})', F(10), align=AL(), fmt=COUNT_FMT)
    for i in range(SUBTEAM_ROWS):
        r, k = R_T1 + i, i + 1
        t, u = f"$M{r}", f"$N{r}"
        put(ws, (r, 13), f'=IFERROR(INDEX(cTeam,MATCH({k},cSubSeq,0)),"")', F(10), align=AL("left"))
        put(ws, (r, 14), f'=IFERROR(INDEX(cSub,MATCH({k},cSubSeq,0)),"")', F(10, True), align=AL("left"))
        formulas = [f"COUNTIFS(cTeam,{t},cSub,{u},cMatch,1)",
                    f"SUMIFS(dPresent,dTeam,{t},dSub,{u},dInPeriod,1)",
                    f"SUMIFS(dLeave,dTeam,{t},dSub,{u},dInPeriod,1)",
                    f"SUMIFS(d_A,dTeam,{t},dSub,{u},dInPeriod,1)",
                    f"SUMIFS(cBLUsed,cTeam,{t},cSub,{u},cMatch,1)",
                    f"SUMIFS(cBLBal,cTeam,{t},cSub,{u},cMatch,1)",
                    f"SUMIFS(cBLDone,cTeam,{t},cSub,{u},cMatch,1)",
                    f"SUMIFS(cBLPend,cTeam,{t},cSub,{u},cMatch,1)"]
        for j, fx in enumerate(formulas):
            put(ws, (r, 15 + j), f'=IF({u}="","",{fx})', F(10), align=AL(), fmt=COUNT_FMT)
    put(ws, (R_WARN, 2), f'=IF(MAX(cTeamSeq)>{TEAM_ROWS},"More teams than rows: "&(MAX(cTeamSeq)-{TEAM_ROWS})'
                         f'&" not shown - increase TEAM_ROWS in the script","")', F(9, True, "C00000"))
    put(ws, (R_WARN, 13), f'=IF(MAX(cSubSeq)>{SUBTEAM_ROWS},"More sub teams than rows: "&(MAX(cSubSeq)-{SUBTEAM_ROWS})'
                          f'&" not shown - increase SUBTEAM_ROWS in the script","")', F(9, True, "C00000"))

    # ---- Month-wise trend
    put(ws, (R_SEC2, 2), "Month-wise Trend  (selected year, team & sub team)", sec_font)
    trend_cols = [("Present", "dPresent"), ("Leave", "dLeave"), ("Absent", "d_A"),
                  ("WFO", "d_WFO"), ("WFH", "d_WFH"), ("NCRW", "d_NCRW")]
    header(ws, R_TH2, 2, ["Month"] + [t[0] for t in trend_cols], size=9, height=20)
    for m in range(1, 13):
        r = R_T2 + m - 1
        put(ws, (r, 2), MONTHS[m - 1], F(10, True), align=AL(), border=BORDER)
        for j, (_, nm) in enumerate(trend_cols):
            put(ws, (r, 3 + j), f"=SUMIFS({nm},dYear,selYear,dMonth,{m},dMatch,1)", F(10), None, AL(),
                BORDER, COUNT_FMT)
    put(ws, (R_T2_TOT, 2), "Total", F(10, True), PF(GREEN_LIGHT), AL(), BORDER)
    for j in range(len(trend_cols)):
        L = CL(3 + j)
        put(ws, (R_T2_TOT, 3 + j), f"=SUM({L}{R_T2}:{L}{R_T2 + 11})", F(10, True), PF(GREEN_LIGHT), AL(),
            BORDER, COUNT_FMT)
    chart = BarChart()
    chart.type, chart.grouping = "col", "clustered"
    chart.title = "Present vs Leave days by month"
    chart.y_axis.title = "Days"
    chart.add_data(Reference(ws, min_col=3, max_col=4, min_row=R_TH2, max_row=R_T2 + 11), titles_from_data=True)
    chart.set_categories(Reference(ws, min_col=2, min_row=R_T2, max_row=R_T2 + 11))
    chart.series[0].graphicalProperties.solidFill = "70AD47"
    chart.series[1].graphicalProperties.solidFill = "ED7D31"
    chart.x_axis.delete = False
    chart.y_axis.delete = False
    chart.legend.position = "b"
    chart.height, chart.width = 7.6, 24.5
    ws.add_chart(chart, f"J{R_SEC2}")

    # ---- Employee-wise table
    put(ws, (R_SEC3, 2), "Employee-wise Summary", sec_font)
    groups = [(2, 5, "Employee", GREEN_DARK), (6, 8, "Selected Period (days)", "375623"),
              (9, 12, "Block Leave", "C55A11"), (13, 14, "PL", "2F75B5"), (15, 16, "SL", "BF8F00"),
              (17, 18, "WFH", "548235"), (19, 20, "NCRW", "385723"), (21, 22, "WFO", "548235")]
    for c1, c2, label, color in groups:
        merge(ws, R_GH3, c1, R_GH3, c2)
        put(ws, (R_GH3, c1), label, F(10, True, "FFFFFF"), PF(color), AL(), BORDER)
        for c in range(c1 + 1, c2 + 1):
            put(ws, (R_GH3, c), None, fill=PF(color), border=BORDER)
    header(ws, R_TH3, 2, ["Emp ID", "Employee Name", "Team", "Sub Team", "Present", "Leave", "Absent",
                          "Status", "Start Date", "Used (days)", "Balance (days)"]
           + ["Utilized", "Balance"] * 5, size=9, height=30)

    for i in range(MAX_EMPLOYEES):
        r, k = R_T3 + i, i + 1
        s = f"$A{r}"
        put(ws, (r, 1), f'=IFERROR(MATCH({k},cEmpSeq,0),"")', F(8, color="BFBFBF"))
        cells = [
            (f'INDEX({M}$A${M_FIRST}:$A${M_LAST},{s})', "General", "center"),
            (f'INDEX({M}$B${M_FIRST}:$B${M_LAST},{s})&""', "General", "left"),
            (f"INDEX(cTeam,{s})", "General", "left"),
            (f"INDEX(cSub,{s})", "General", "left"),
            (f"SUMIFS(dPresent,dSlot,{s},dInPeriod,1)", COUNT_FMT, "center"),
            (f"SUMIFS(dLeave,dSlot,{s},dInPeriod,1)", COUNT_FMT, "center"),
            (f"SUMIFS(d_A,dSlot,{s},dInPeriod,1)", COUNT_FMT, "center"),
            (f'INDEX({M}$G${M_FIRST}:$G${M_LAST},{s})&""', "General", "center"),
            (f'IF(ISNUMBER(INDEX({M}$H${M_FIRST}:$H${M_LAST},{s})),INDEX({M}$H${M_FIRST}:$H${M_LAST},{s}),"")',
             DATE_FMT, "center"),
            (f"INDEX(cBLUsed,{s})", COUNT_FMT, "center"),
            (f"INDEX(cBLBal,{s})", BAL_FMT, "center"),
        ]
        for j, (fx, fmt, h) in enumerate(cells):
            put(ws, (r, 2 + j), f'=IF({s}="","",{fx})', F(10), align=AL(h), fmt=fmt)
        col = 13
        for code in ("PL", "SL", "WFH", "NCRW", "WFO"):
            used = f"{CL(col)}{r}"
            extra = f"+INDEX(cPLCF,{s})" if code == "PL" else ""
            put(ws, (r, col), f'=IF({s}="","",SUMIFS(d_{code},dSlot,{s},dInYTD,1))', F(10), align=AL(),
                fmt=COUNT_FMT)
            put(ws, (r, col + 1), f'=IF({s}="","",IF(LIM_{code}="","-",LIM_{code}{extra}-{used}))',
                F(10, True), align=AL(), fmt=BAL_FMT)
            col += 2

    # ---- Table borders / banding only on filled rows
    band = PF("F2F7EE")
    for rng, key in ((f"B{R_T1}:K{R_T1 + TEAM_ROWS - 1}", f"$B{R_T1}"),
                     (f"M{R_T1}:V{R_T1 + SUBTEAM_ROWS - 1}", f"$N{R_T1}"),
                     (f"B{R_T3}:V{R_T3_LAST}", f"$B{R_T3}")):
        ws.conditional_formatting.add(rng, FormulaRule(formula=[f'AND({key}<>"",MOD(ROW(),2)=0)'],
                                                       fill=band, border=BORDER))
        ws.conditional_formatting.add(rng, FormulaRule(formula=[f'{key}<>""'], border=BORDER))
    ws.conditional_formatting.add(           # block leave pending -> amber
        f"L{R_T3}:L{R_T3_LAST}", FormulaRule(formula=[f'AND(ISNUMBER($L{R_T3}),$L{R_T3}>0)'],
                                             fill=PF("FCE4D6"), font=Font(color="C55A11", bold=True)))

    ws.freeze_panes = "A6"
    landscape(ws)


