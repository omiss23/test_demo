# 3. STYLE HELPERS
# =============================================================================
FONT_NAME = "Arial"
GREEN, GREEN_DARK, GREEN_LIGHT = "217346", "1E5631", "E2EFDA"
YELLOW, GREY_TXT, INPUT_BLUE = "FFF2CC", "7F7F7F", "1F4E79"
ZERO_BLANK = "0;-0;;@"           # hide zeros
COUNT_FMT = "0"
BAL_FMT = "0;[Red]-0;0"          # negative balance in red
DATE_FMT = "dd-mmm-yyyy"

_thin = Side(style="thin", color="BFBFBF")
_red = Side(style="thin", color="C00000")
BORDER = Border(left=_thin, right=_thin, top=_thin, bottom=_thin)
RED_BORDER = Border(left=_red, right=_red, top=_red, bottom=_red)


def F(size=10, bold=False, color="000000", italic=False):
    return Font(name=FONT_NAME, size=size, bold=bold, color=color, italic=italic)


def PF(hex_color):
    return PatternFill(start_color=hex_color, end_color=hex_color, fill_type="solid")


def AL(h="center", wrap=False, v="center"):
    return Alignment(horizontal=h, vertical=v, wrap_text=wrap)


def put(ws, where, value=None, font=None, fill=None, align=None, border=None, fmt=None):
    c = ws[where] if isinstance(where, str) else ws.cell(row=where[0], column=where[1])
    if value is not None:
        c.value = value
    if font is not None:
        c.font = font
    if fill is not None:
        c.fill = fill
    if align is not None:
        c.alignment = align
    if border is not None:
        c.border = border
    if fmt is not None:
        c.number_format = fmt
    return c


def merge(ws, r1, c1, r2, c2):
    ws.merge_cells(start_row=r1, start_column=c1, end_row=r2, end_column=c2)


def header(ws, row, col, labels, widths=None, fill=GREEN, height=30, size=10):
    for i, label in enumerate(labels):
        put(ws, (row, col + i), label, F(size, True, "FFFFFF"), PF(fill), AL(wrap=True), BORDER)
        if widths:
            ws.column_dimensions[CL(col + i)].width = widths[i]
    ws.row_dimensions[row].height = height


def ref(sheet):
    """Quoted sheet prefix for formulas, e.g.  'Employee Master'!"""
    return "'" + sheet.replace("'", "''") + "'!"


def add_name(wb, name, target):
    dn = DefinedName(name, attr_text=target)
    try:
        wb.defined_names[name] = dn       # openpyxl 3.1+
    except TypeError:
        wb.defined_names.append(dn)       # openpyxl 3.0.x


def serial(d):
    return (d - date(1899, 12, 30)).days


def list_validation(source, title, message):
    return DataValidation(type="list", formula1=source, allow_blank=True, showErrorMessage=True,
                          errorTitle=title, error=message)


def note(ws, r, c1, c2, text, height=None):
    merge(ws, r, c1, r, c2)
    put(ws, (r, c1), text, F(9, italic=True, color=GREY_TXT), align=AL("left", wrap=True, v="top"))
    if height:
        ws.row_dimensions[r].height = height


def landscape(ws):
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.sheet_properties.pageSetUpPr = PageSetupProperties(fitToPage=True)


def register_styles(wb):
    specs = [
        ("grid", F(9), AL(), "General"),           # attendance code cells
        ("cnt", F(9), AL(), ZERO_BLANK),           # per-code counts on month tabs
        ("cntb", F(9, True), AL(), ZERO_BLANK),    # totals on month tabs
        ("txt", F(9), AL("left"), "General"),      # names / teams on month tabs
        ("inp", F(10), AL("left"), "General"),     # Employee Master input cells
    ]
    for name, font, align, fmt in specs:
        st = NamedStyle(name=name)
        st.font, st.alignment, st.border, st.number_format = font, align, BORDER, fmt
        wb.add_named_style(st)


